# Copy to .env and fill in. Never commit real values (.env is gitignored).
#
# The listener reads listener/.env or this repo-root .env on the VPS.
# The brain reads its variables from Netlify: Site configuration > Environment variables.

# ── Listener (listener/, runs on the VPS) ────────────────────────────────────

# WhatsApp ID of the one group the bot watches, e.g. 120363000000000000@g.us
# Leave empty on the first run: the listener prints every group you are in, with its ID.
TARGET_GROUP_ID=

# Full URL of the deployed brain function,
# e.g. https://your-site.netlify.app/.netlify/functions/brain
BRAIN_WEBHOOK_URL=

# Prefix that turns a message into a bot command. Optional, defaults to "!".
TRIGGER=!

# ── Brain (netlify/functions/brain.js, set in Netlify, not on the VPS) ───────

# OpenAI API key used to generate replies (model gpt-4o-mini).
OPENAI_API_KEY=

# ── Optional, shared by both ─────────────────────────────────────────────────

# Shared secret that stops strangers from calling the brain (and spending your
# OpenAI credit). If you use it, set the SAME value in Netlify and on the VPS.
# The listener sends it in the x-webhook-secret header; the brain rejects
# requests without it.
WEBHOOK_SECRET=
